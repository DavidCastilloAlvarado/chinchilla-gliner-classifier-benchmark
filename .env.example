# GLiNER2 FastAPI serving configuration.
# Copy this file to .env for local development:
#   cp .env.example .env
# Existing system environment variables take precedence over these values.

# Local checkpoint: base, multi, or decide.
MODEL_NAME=decide

# Optional absolute or project-relative override for model weights.
# Leave empty to use temp/<model-name>.
MODEL_DIR=

# Inference device: cpu or cuda.
GPU_MODE=cpu

# Compile during startup; the model is always warmed up before readiness.
COMPILE_MODEL=false

# Maximum queueing window used to collect compatible requests.
BATCH_WINDOW_MS=3

# Maximum number of requests in one model batch.
N_CONCURRENCY=8

# Hard cap on queued requests. Full queues return HTTP 429.
MAX_QUEUE_SIZE=256

# Maximum time a request waits for an inference result. Timeouts return HTTP 504.
REQUEST_TIMEOUT_SECONDS=30

# Directory containing stored app JSON schemas.
APPS_DIR=app/apps
